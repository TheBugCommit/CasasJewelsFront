<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    {% for product in products %}
        <div class="col">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="bg-light p-5 text-center rounded-top" style="font-size: 4rem;">💎</div>
                <div class="card-body d-flex flex-column text-center">
                    <h5 class="card-title fw-bold">{{ product.name }}</h5>
                    <p class="card-text text-brand fw-bold fs-4 mb-3">{{ product.price|number_format(2, ',', '.') }} €</p>

                    <a href="{{ path('frontend_product_detail', { id: product.id }) }}" class="btn btn-outline-dark mt-auto w-100">
                        Veure Detalls
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted mt-5">
            <p class="fs-5">Actualment no hi ha productes disponibles.</p>
        </div>
    {% endfor %}
</div>
