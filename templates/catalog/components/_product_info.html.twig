<div class="col-md-6 px-lg-5">
    <h1 class="display-5 fw-bold mb-3">{{ product.name }}</h1>
    <p class="fs-1 text-brand fw-bold mb-4">{{ product.price|number_format(2, ',', '.') }} €</p>
    <p class="text-muted mb-3"><span class="badge bg-secondary">{{ product.category }}</span></p>

    <h5 class="fw-bold mt-4">Descripció</h5>
    <p class="text-muted fs-5" style="line-height: 1.6;">{{ product.description }}</p>

    <ul class="list-unstyled mt-4 mb-5 text-muted">
        <li class="mb-2"><small>📦 <strong>Temps de lliurament:</strong> 24/48 hores a domicili</small></li>
    </ul>

    {% include 'catalog/components/_add_to_cart.html.twig' %}
</div>
