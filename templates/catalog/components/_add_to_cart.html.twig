<div class="card border-0 shadow-sm bg-light">
    <div class="card-body p-4">
        <form action="{{ path('frontend_cart_add') }}" method="POST" class="d-flex align-items-center">
            <input type="hidden" name="product_id" value="{{ product.id }}">

            <div class="me-3">
                <label for="quantity" class="form-label fw-bold mb-1 small text-muted">Quantitat</label>
                <input type="number" id="quantity" name="quantity" value="1" min="1" max="10" class="form-control form-control-lg text-center" style="width: 90px;">
            </div>

            <button type="submit" class="btn btn-brand btn-lg w-100 mt-3 shadow-sm fw-bold">
                🛒 Afegir al carretó
            </button>
        </form>
    </div>
</div>
