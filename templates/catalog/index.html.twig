{% extends 'base.html.twig' %}

{% block title %}Casas Jewels - Catàleg{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('frontend_catalog') }}">Inici</a></li>
                <li class="breadcrumb-item active" aria-current="page">Catàleg</li>
            </ol>
        </nav>

        <h1 class="mb-4 text-center fw-bold">Les Nostres Joies</h1>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            {% for product in products %}
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <div class="bg-light p-5 text-center rounded-top" style="font-size: 4rem;">💎</div>
                        <div class="card-body d-flex flex-column text-center">
                            <h5 class="card-title fw-bold">{{ product.name }}</h5>
                            <p class="card-text text-brand fw-bold fs-4 mb-3">{{ product.price|number_format(2, ',', '.') }} €</p>

                            <a href="{{ path('frontend_product_detail', { id: product.id }) }}" class="btn btn-outline-dark mt-auto w-100">
                                Veure Detalls
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-muted mt-5">
                    <p class="fs-5">Actualment no hi ha productes disponibles.</p>
                </div>
            {% endfor %}
        </div>

        {# PAGINACIÓ #}
        {% if totalPages > 1 %}
            <nav aria-label="Paginació de productes" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                        <a class="page-link" href="{{ currentPage > 1 ? path('frontend_catalog', { page: currentPage - 1, limit: limit }) : '#' }}">
                            &laquo; Anterior
                        </a>
                    </li>
                    {% for i in 1..totalPages %}
                        <li class="page-item {% if currentPage == i %}active{% endif %}">
                            <a class="page-link" href="{{ path('frontend_catalog', { page: i, limit: limit }) }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                        <a class="page-link" href="{{ currentPage < totalPages ? path('frontend_catalog', { page: currentPage + 1, limit: limit }) : '#' }}">
                            Següent &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
