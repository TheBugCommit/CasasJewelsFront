{% extends 'base.html.twig' %}

{% block title %}Casas Jewels - Catàleg{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('frontend_catalog') }}">Inici</a></li>
                <li class="breadcrumb-item active" aria-current="page">Catàleg</li>
            </ol>
        </nav>

        <h1 class="mb-4 text-center fw-bold">Les Nostres Joies</h1>

        {% include 'catalog/components/_limit_selector.html.twig' %}

        {% include 'catalog/components/_product_grid.html.twig' %}

        {% include 'catalog/components/_pagination.html.twig' %}
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('js/catalog-limit-control.js') }}" defer></script>
{% endblock %}
