{% extends 'base.html.twig' %}

{% block title %}El meu carretó - Casas Jewels{% endblock %}

{% block body %}
    <div class="container mt-4">
        {# BREADCRUMB #}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('frontend_catalog') }}">Inici</a></li>
                <li class="breadcrumb-item active" aria-current="page">El meu carretó</li>
            </ol>
        </nav>

        <h1 class="mb-4 fw-bold">🛒 El meu carretó</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tancar"></button>
            </div>
        {% endfor %}

        {% if items is empty %}
            {% include 'cart/components/_empty_cart.html.twig' %}
        {% else %}
            {% include 'cart/components/_cart_table.html.twig' %}

            {% include 'cart/components/_cart_actions.html.twig' %}
        {% endif %}

    </div>
{% endblock %}
