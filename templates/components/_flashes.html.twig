<div class="flash-messages-container mt-3 mb-3">
    {% for label, messages in app.flashes %}
        {% set alertClass = label == 'error' ? 'danger' : label %}
        {% for message in messages %}
            <div class="alert alert-{{ alertClass }} alert-dismissible fade show shadow-sm" role="alert">
                {% if label == 'success' %}
                    <i class="bi bi-check-circle-fill me-2"></i>
                {% elseif label == 'error' %}
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                {% endif %}
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tancar"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
