{% extends 'base.html.twig' %}

{% block title %}Finalitzar Compra - Casas Jewels{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('frontend_catalog') }}">Inici</a></li>
                <li class="breadcrumb-item"><a href="{{ path('frontend_cart_index') }}">Carretó</a></li>
                <li class="breadcrumb-item active" aria-current="page">Finalitzar Compra</li>
            </ol>
        </nav>

        <h1 class="mb-4 fw-bold">💳 Finalitzar Compra</h1>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger shadow-sm">{{ message }}</div>
        {% endfor %}

        <div class="row">
            {# FORMULARI DE DADES #}
            <div class="col-md-7 col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold fs-5 py-3">
                        Dades de Contacte i Enviament
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form action="{{ path('frontend_checkout_process') }}" method="POST">
                            <div class="mb-4">
                                <label for="clientName" class="form-label fw-bold text-muted">Nom i Cognoms *</label>
                                <input type="text" class="form-control form-control-lg bg-light" id="clientName" name="clientName" placeholder="Ex: Joan Pérez" required>
                            </div>

                            <div class="mb-5">
                                <label for="clientEmail" class="form-label fw-bold text-muted">Correu electrònic *</label>
                                <input type="email" class="form-control form-control-lg bg-light" id="clientEmail" name="clientEmail" placeholder="joan@exemple.cat" required>
                                <div class="form-text mt-2 text-primary">T'enviarem la confirmació de la comanda i l'enllaç de seguiment a aquest correu.</div>
                            </div>

                            <button type="submit" class="btn btn-brand btn-lg w-100 fw-bold shadow-sm py-3">
                                Pagar de forma segura (PayPal) &raquo;
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            {# RESUM DE COMANDA #}
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm border-0 bg-white">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-3">Resum de la Comanda</h5>

                        <div class="d-flex justify-content-between mb-3 text-muted">
                            <span>Subtotal dels articles</span>
                            <span>{{ total|number_format(2, ',', '.') }} €</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                            <span>Cost d'enviament</span>
                            <span>Gratuït</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 text-muted">
                            <span>Impostos (IVA inclòs)</span>
                            <span>Ja inclosos</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-4 fw-bold fs-4">
                            <span>Total</span>
                            <span class="text-brand">{{ total|number_format(2, ',', '.') }} €</span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a href="{{ path('frontend_cart_index') }}" class="text-muted text-decoration-none small">
                        &laquo; Modificar la meva cistella
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
