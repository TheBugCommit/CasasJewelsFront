{% extends 'base.html.twig' %}

{% block title %}Finalitzar Compra - Casas Jewels{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('frontend_catalog') }}">Inici</a></li>
                <li class="breadcrumb-item"><a href="{{ path('frontend_cart_index') }}">Carretó</a></li>
                <li class="breadcrumb-item active" aria-current="page">Finalitzar Compra</li>
            </ol>
        </nav>

        <h1 class="mb-4 fw-bold">💳 Finalitzar Compra</h1>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger shadow-sm">{{ message }}</div>
        {% endfor %}

        <div class="row">
            {% include 'checkout/components/_checkout_form.html.twig' %}

            {% include 'checkout/components/_order_summary.html.twig' %}
        </div>
    </div>
{% endblock %}
