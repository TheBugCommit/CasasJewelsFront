<div class="col-md-7 col-lg-8 mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold fs-5 py-3">
            Dades de Contacte i Enviament
        </div>
        <div class="card-body p-4 p-md-5">
            <form action="{{ path('frontend_checkout_process') }}" method="POST">
                <div class="mb-4">
                    <label for="clientName" class="form-label fw-bold text-muted">Nom i Cognoms *</label>
                    <input type="text" class="form-control form-control-lg bg-light" id="clientName" name="clientName" placeholder="Ex: Joan Pérez" required>
                </div>

                <div class="mb-5">
                    <label for="clientEmail" class="form-label fw-bold text-muted">Correu electrònic *</label>
                    <input type="email" class="form-control form-control-lg bg-light" id="clientEmail" name="clientEmail" placeholder="joan@exemple.cat" required>
                    <div class="form-text mt-2 text-primary">T'enviarem la confirmació de la comanda i l'enllaç de seguiment a aquest correu.</div>
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100 fw-bold shadow-sm py-3">
                    Pagar de forma segura (PayPal) &raquo;
                </button>
            </form>
        </div>
    </div>
</div>
